# Gentleman Guardian Angel - project config (overrides ~/.config/gga/config)
#
# GGA reads a single rules file, so this config builds .gga-rules.md from
# AGENTS.md and the installed skills every time it is loaded. The skills stay
# the single source of truth; .gga-rules.md is generated and gitignored.

PROVIDER="claude"

FILE_PATTERNS="*.php"
EXCLUDE_PATTERNS="vendor/*,storage/*,bootstrap/cache/*,node_modules/*,public/*"

RULES_FILE=".gga-rules.md"
STRICT_MODE="true"
TIMEOUT="300"

gga_build_rules() {
  local root skills
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  skills="$root/.agents/skills"

  {
    echo "# Review rules for FunWork"
    echo
    echo "Generated by .gga from AGENTS.md and .agents/skills. Do not edit."
    echo "Report only violations of these rules in the staged files."
    for source in \
      "$root/AGENTS.md" \
      "$skills/clean-code/SKILL.md" \
      "$skills/error-handling/SKILL.md" \
      "$skills/testing-strategy/SKILL.md" \
      "$skills/laravel-conventions/SKILL.md" \
      "$skills/laravel-conventions/references/livewire.md" \
      "$skills/laravel-conventions/references/pest.md" \
      "$skills/laravel-conventions/references/errors.md"; do
      [[ -f "$source" ]] || continue
      echo
      echo "<!-- source: ${source#"$root"/} -->"
      echo
      # Drop YAML frontmatter; the review only needs the rules.
      awk 'NR == 1 && /^---$/ { skip = 1; next } skip && /^---$/ { skip = 0; next } !skip' "$source"
    done
  } > "$root/$RULES_FILE"
}

gga_build_rules
